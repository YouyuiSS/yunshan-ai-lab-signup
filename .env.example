# OpenAI-compatible LLM: used by the signup page AI helper.
# Example providers: OpenAI, Azure OpenAI-compatible gateways, vLLM, OneAPI, LiteLLM, SiliconFlow-compatible endpoints.
OPENAI_COMPAT_BASE_URL="https://api.openai.com/v1"
OPENAI_COMPAT_API_KEY="YOUR_API_KEY"
OPENAI_COMPAT_MODEL="gpt-4o-mini"
OPENAI_COMPAT_TIMEOUT_MS="20000"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PostgreSQL: Used by the signup form and admin management backend.
DATABASE_JDBC_URL="jdbc:postgresql://HOST:5432/DB_NAME?currentSchema=evo"
DATABASE_USERNAME="DB_USERNAME"
DATABASE_PASSWORD="DB_PASSWORD"
APP_BASE_PATH="/ai-lab-signup"
VITE_PORT="3000"
VITE_ALLOWED_HOSTS="aistudio.taas.huawei.com"
API_PORT="8787"

OPENAI_COMPAT_BASE_URL="https://api.openai.com/v1"
OPENAI_COMPAT_API_KEY="YOUR_API_KEY"
OPENAI_COMPAT_MODEL="gpt-4o-mini"
OPENAI_COMPAT_TIMEOUT_MS="20000"
